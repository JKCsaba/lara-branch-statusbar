+// BEGIN v11.10 SEARCH USING WORKING DOCK SETTER
+// Direct root-folder pageControl path confirmed by the supplied 11.8 trace.
+// No subview scan, struct transform, associated-object state, or new transport.
+static uint64_t rc_search120_control(RemoteCall *proc) {
+    uint64_t pageClass = remote_getClass(proc, "SBIconListPageControl");
+    uint64_t controllerClass = remote_getClass(proc, "SBIconController");
+    if (!pageClass || !controllerClass || proc.lastError.length) return 0;
+    uint64_t controller = remote_msg(proc, controllerClass,
+        remote_sel(proc, "sharedInstance"), 0, 0, 0, 0);
+    if (!controller || proc.lastError.length) return 0;
+    uint64_t manager = remote_msg(proc, controller,
+        remote_sel(proc, "iconManager"), 0, 0, 0, 0);
+    if (!manager || proc.lastError.length) return 0;
+    uint64_t responds = remote_sel(proc, "respondsToSelector:");
+    uint64_t folderSelector = remote_sel(proc, "rootFolderController");
+    if (proc.lastError.length || !remote_msg(proc, manager, responds,
+        folderSelector, 0, 0, 0)) return 0;
+    uint64_t folder = remote_msg(proc, manager, folderSelector, 0, 0, 0, 0);
+    if (!folder || proc.lastError.length) return 0;
+    uint64_t pageSelector = remote_sel(proc, "pageControl");
+    if (proc.lastError.length || !remote_msg(proc, folder, responds,
+        pageSelector, 0, 0, 0)) return 0;
+    uint64_t page = remote_msg(proc, folder, pageSelector, 0, 0, 0, 0);
+    if (!page || proc.lastError.length) return 0;
+    return remote_msg(proc, page, remote_sel(proc, "isKindOfClass:"),
+        pageClass, 0, 0, 0) && !proc.lastError.length ? page : 0;
+}
+
+
+static int rc_search120_set_lift(RemoteCall *proc, double liftPoints, bool restore) {
+    if (!proc || proc.lastError.length) return -1;
+    if (liftPoints < 0.0 || liftPoints > 140.0) return -1;
+    printf("(rc) v11.10 search: resolve direct root-folder pageControl\n");
+    fflush(stdout);
+    uint64_t control = rc_search120_control(proc);
+    if (!control || proc.lastError.length) return -2;
+    uint64_t layer = remote_msg(proc, control, remote_sel(proc, "layer"), 0, 0, 0, 0);
+    if (!layer || proc.lastError.length) return -3;
+
+    // Same absolute numeric CALayer property and same main-thread helper as
+    // set_v61_dock_vertical_lift in the unchanged, working 11.3 baseline.
+    double y = restore ? 0.0 : -liftPoints;
+    char yBuffer[64];
+    snprintf(yBuffer, sizeof(yBuffer), "%.17g", y);
+    uint64_t value = rc_decimal_number(proc, yBuffer);
+    uint64_t key = remote_NSString(proc, "transform.translation.y");
+    uint64_t selSet = remote_sel(proc, "setValue:forKeyPath:");
+    if (!value || !key || !selSet || proc.lastError.length) return -4;
+    printf("(rc) v11.10 search: direct control=0x%llx layer=0x%llx y=%.0f; invoke existing Dock setter helper\n",
+           (unsigned long long)control, (unsigned long long)layer, y);
+    fflush(stdout);
+    uint64_t args[2] = {value, key};
+    int r = rc_invoke_objc_on_main_poll(proc, layer, selSet, args, 2, NULL, 900,
+                                      restore ? "v1110-search-restore" : "v1110-search-lift");
+    printf("(rc) v11.10 search: Dock-pattern setter returned %d\n", r);
+    fflush(stdout);
+    return r == 0 ? 0 : -5;
+}
+
+int lift_home_search_control(RemoteCall *proc, double liftPoints) {
+    return rc_search120_set_lift(proc, liftPoints, false);
+}
+
+int restore_home_search_control(RemoteCall *proc) {
+    return rc_search120_set_lift(proc, 0, true);
+}
+// END v11.10 SEARCH USING WORKING DOCK SETTER
