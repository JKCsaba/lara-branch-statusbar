+            rc_island120_original_window = window;
+            rc_island120_original_frame = before;
+            rc_island120_have_original = true;
+        }
+        rc_island121_proc = proc;
+        rc_island121_window_addr = window;
+        rc_island121_controller = controller;
+        rc_island121_apply_method = method;
+        rc_island121_original_imp = original;
+        rc_island121_alias_sel = aliasSel;
