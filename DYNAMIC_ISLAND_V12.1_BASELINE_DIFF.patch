+    // 64-point compact band. Rotate the full native window so expansion grows
+    // into the display. Offset is now a small calibration correction, not a
+    // 780-point translation of the full-screen window.
+    double correction = edgePoints - (rc_island120_original_frame.size.height - 64.0);
+    char number[64];
+    snprintf(number, sizeof(number), "%.17g", correction);
+    if (rc_island121_layer_value(proc, layer, "transform.rotation.z", "3.1415926535897931") ||
