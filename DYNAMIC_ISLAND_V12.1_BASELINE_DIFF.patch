+static uint64_t rc_island120_send(RemoteCall *proc, uint64_t target,
+                                 uint64_t selector, uint64_t a0) {
+    if (!proc || proc.lastError.length || !target || !selector) return 0;
+    return remote_msg(proc, target, selector, a0, 0, 0, 0);
+}
+
+// Only public collection getters on UIApplication and UIWindowScene are used.
+// UIKit scenes are snapshotted once; only an Island scene's own windows are read.
+static uint64_t rc_island120_window(RemoteCall *proc) {
+    uint64_t sceneClass = remote_getClass(proc, "SBSystemApertureWindowScene");
+    uint64_t windowClass = remote_getClass(proc, "SBSystemApertureWindow");
+    uint64_t appClass = remote_getClass(proc, "UIApplication");
+    if (!sceneClass || !windowClass || !appClass || proc.lastError.length) return 0;
+    uint64_t shared = remote_sel(proc, "sharedApplication");
+    uint64_t connected = remote_sel(proc, "connectedScenes");
+    uint64_t allObjects = remote_sel(proc, "allObjects");
+    uint64_t countSel = remote_sel(proc, "count");
+    uint64_t atIndex = remote_sel(proc, "objectAtIndex:");
+    uint64_t kind = remote_sel(proc, "isKindOfClass:");
+    uint64_t windowsSel = remote_sel(proc, "windows");
+    if (proc.lastError.length || !shared || !connected || !allObjects ||
+        !countSel || !atIndex || !kind || !windowsSel) return 0;
+    uint64_t app = rc_island120_send(proc, appClass, shared, 0);
+    uint64_t scenes = rc_island120_send(proc, app, connected, 0);
+    uint64_t array = rc_island120_send(proc, scenes, allObjects, 0);
+    uint64_t count = rc_island120_send(proc, array, countSel, 0);
+    if (!array || count == 0 || count > 32 || proc.lastError.length) return 0;
+    uint64_t match = 0;
+    for (uint64_t i = 0; i < count; i++) {
+        uint64_t scene = rc_island120_send(proc, array, atIndex, i);
+        if (!rc_island120_send(proc, scene, kind, sceneClass)) continue;
+        uint64_t windows = rc_island120_send(proc, scene, windowsSel, 0);
+        uint64_t windowCount = rc_island120_send(proc, windows, countSel, 0);
+        if (!windows || windowCount > 8 || proc.lastError.length) return 0;
+        for (uint64_t j = 0; j < windowCount; j++) {
+            uint64_t window = rc_island120_send(proc, windows, atIndex, j);
+            if (!rc_island120_send(proc, window, kind, windowClass)) continue;
+            if (match && match != window) {
+                printf("(rc) v12.0 island: multiple Island windows; unchanged\n");
+                return 0;
+            }
+            match = window;
+        }
+    }
+    return proc.lastError.length ? 0 : match;
+}
