+static int rc_island120_apply(RemoteCall *proc, double offsetPoints, bool restore) {
+    if (!proc || proc.lastError.length) return -1;
+    if (!isfinite(offsetPoints) || offsetPoints < -900 || offsetPoints > 900) return -1;
+    printf("(rc) v12.0 island: resolve Island scene/window\n");
+    fflush(stdout);
+    uint64_t window = rc_island120_window(proc);
+    if (!window || proc.lastError.length) {
+        printf("(rc) v12.0 island: unique Island window unavailable; unchanged\n");
+        return -2;
+    }
+    uint64_t frameSel = remote_sel(proc, "frame");
+    if (!frameSel || proc.lastError.length) return -3;
+    CGRect before = remote_getCGRect(proc, window, frameSel);
+    if (proc.lastError.length || !rc_island120_valid_frame(before)) return -3;
+    bool sameWindow = rc_island120_have_original &&
+        rc_island120_original_proc == proc && rc_island120_original_window == window;
+    if (restore && !sameWindow) return -4;
+    if (!sameWindow) {
+        rc_island120_original_proc = proc;
+        rc_island120_original_window = window;
+        rc_island120_original_frame = before;
+        rc_island120_have_original = true;
+    }
+    CGRect desired = restore ? rc_island120_original_frame : before;
+    if (!restore) desired.origin.y = rc_island120_original_frame.origin.y + offsetPoints;
+    // Absolute offset from the captured original: repeated taps do not accumulate.
+    uint64_t setter = remote_sel(proc, "setFrame:");
+    if (!setter || proc.lastError.length) return -5;
+    printf("(rc) v12.0 island: window=0x%llx before=(%.1f,%.1f %.1fx%.1f) requestedY=%.1f restore=%d\n",
+           (unsigned long long)window, before.origin.x, before.origin.y,
+           before.size.width, before.size.height, desired.origin.y, restore);
+    fflush(stdout);
+    int result = rc_schedule_rect_on_main(proc, window, setter, desired,
+        restore ? "v120-island-restore" : "v120-island-position");
+    if (result || proc.lastError.length) return -5;
+    // Readback reports whether UIKit accepted the origin; it does not prove that
+    // the Island is visible, that touch/expanded states work, or that layout keeps it.
+    usleep(250000);
+    CGRect after = remote_getCGRect(proc, window, frameSel);
+    if (proc.lastError.length || !rc_island120_valid_frame(after)) return -6;
+    printf("(rc) v12.0 island: readback=(%.1f,%.1f %.1fx%.1f) requestedY=%.1f\n",
+           after.origin.x, after.origin.y, after.size.width, after.size.height, desired.origin.y);
+    fflush(stdout);
+    double difference = after.origin.y - desired.origin.y;
+    if (difference < -1.0 || difference > 1.0) return -7;
+    return 0;
+}
