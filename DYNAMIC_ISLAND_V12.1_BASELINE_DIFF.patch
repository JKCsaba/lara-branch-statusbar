+static uint64_t rc_island121_owner_controller(RemoteCall *proc, uint64_t owner,
+                                             uint64_t controllerClass,
+                                             uint64_t kind, uint64_t responds) {
+    if (!owner || proc.lastError.length) return 0;
+    if (rc_island120_send(proc, owner, kind, controllerClass)) return owner;
+    const char *members[] = {"_systemApertureController", "_controller",
+                             "_visibilityDelegate", "_delegate"};
+    for (size_t i = 0; i < sizeof(members) / sizeof(members[0]); i++) {
+        uint64_t candidate = rc_island121_object_member(proc, owner, members[i]);
+        if (proc.lastError.length) return 0;
+        if (rc_island120_send(proc, candidate, kind, controllerClass)) return candidate;
+    }
+    uint64_t getter = remote_sel(proc, "systemApertureController");
+    if (rc_island120_send(proc, owner, responds, getter)) {
+        uint64_t candidate = rc_island120_send(proc, owner, getter, 0);
+        if (rc_island120_send(proc, candidate, kind, controllerClass)) return candidate;
+    }
+    uint64_t typed = rc_island121_typed_controller(proc, owner, controllerClass, kind);
+    if (typed || proc.lastError.length) return typed;
+    // Record actual owner class when none of the typed controller links matched.
+    if (!proc.lastError.length) {
+        uint64_t cls = RemoteArbCall(proc, object_getClass, owner);
+        uint64_t name = cls && !proc.lastError.length ? RemoteArbCall(proc, class_getName, cls) : 0;
+        char buffer[96] = {0};
+        if (name && !proc.lastError.length && [proc remoteRead:name to:buffer size:95])
+            printf("(rc) v12.1 island: no controller link on %s\n", buffer);
+    }
+    return 0;
+}
