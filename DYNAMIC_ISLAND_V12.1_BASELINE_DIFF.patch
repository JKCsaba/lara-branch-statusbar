+static bool rc_island120_valid_frame(CGRect frame) {
+    return isfinite(frame.origin.x) && isfinite(frame.origin.y) &&
+           isfinite(frame.size.width) && isfinite(frame.size.height) &&
+           frame.size.width >= 100 && frame.size.width <= 2000 &&
+           frame.size.height >= 40 && frame.size.height <= 3000;
+}
