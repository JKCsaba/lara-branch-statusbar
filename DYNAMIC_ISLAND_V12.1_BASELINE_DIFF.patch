+static uint64_t rc_island121_find_controller(RemoteCall *proc, uint64_t window,
+                                            uint64_t controllerClass) {
+    uint64_t kind = remote_sel(proc, "isKindOfClass:");
+    uint64_t responds = remote_sel(proc, "respondsToSelector:");
+    uint64_t scene = rc_island120_send(proc, window, remote_sel(proc, "windowScene"), 0);
+    uint64_t delegate = rc_island120_send(proc, scene, remote_sel(proc, "delegate"), 0);
+    uint64_t found = rc_island121_owner_controller(proc, delegate, controllerClass, kind, responds);
+    if (found || proc.lastError.length) return found;
+    uint64_t appClass = remote_getClass(proc, "UIApplication");
+    uint64_t app = rc_island120_send(proc, appClass, remote_sel(proc, "sharedApplication"), 0);
+    found = rc_island121_owner_controller(proc, app, controllerClass, kind, responds);
+    if (found || proc.lastError.length) return found;
+    uint64_t root = rc_island120_send(proc, window, remote_sel(proc, "rootViewController"), 0);
+    found = rc_island121_owner_controller(proc, root, controllerClass, kind, responds);
+    if (found || proc.lastError.length || !root) return found;
+    // Inspect direct child controllers only. No recursive view/controller walk.
+    uint64_t children = rc_island120_send(proc, root, remote_sel(proc, "childViewControllers"), 0);
+    uint64_t count = rc_island120_send(proc, children, remote_sel(proc, "count"), 0);
+    uint64_t atIndex = remote_sel(proc, "objectAtIndex:");
+    if (count > 8 || proc.lastError.length) return 0;
+    for (uint64_t i = 0; i < count; i++) {
+        uint64_t child = rc_island120_send(proc, children, atIndex, i);
+        found = rc_island121_owner_controller(proc, child, controllerClass, kind, responds);
+        if (found || proc.lastError.length) return found;
+    }
+    return 0;
+}
