+        fabs(resetFrame.origin.x - rc_island120_original_frame.origin.x) > 1.0 ||
+        fabs(resetFrame.size.width - rc_island120_original_frame.size.width) > 1.0 ||
+        fabs(resetFrame.size.height - rc_island120_original_frame.size.height) > 1.0)
+        goto island121_rollback;
