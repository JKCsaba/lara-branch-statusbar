+// Leave enable_upside_down and all 11.3 visuals unchanged. The confirmed 12.0
+// window resolver/position helper is retained above. No subviews are traversed.
+static __weak RemoteCall *rc_island121_proc;
+static uint64_t rc_island121_window_addr, rc_island121_controller;
+static uint64_t rc_island121_apply_method, rc_island121_original_imp;
