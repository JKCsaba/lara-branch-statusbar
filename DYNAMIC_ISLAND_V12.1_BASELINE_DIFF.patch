+    uint64_t frameSetter = remote_sel(proc, "setFrame:");
+    if (!frameSetter || proc.lastError.length) goto island121_rollback;
+    if (rc_schedule_rect_on_main(proc, window, frameSetter, rc_island120_original_frame,
