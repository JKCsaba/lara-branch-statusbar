+// Only constant-return leaf code is accepted as the orientation no-op. The
+// caller expects void, so its return register is ignored. No object memory or
+// argument register is read by this verified donor implementation.
+static bool rc_island121_constant_leaf(const uint32_t words[8]) {
+    size_t i = 0;
+    if (words[i] == 0xd503245fU) i++; // BTI c
+    uint32_t signing = 0;
+    if (words[i] == 0xd503233fU || words[i] == 0xd503237fU)
+        signing = words[i++]; // PACIASP / PACIBSP
+    if (words[i] != 0x52800020U && words[i] != 0xd2800020U) return false;
+    i++; // MOV W0,#1 / MOV X0,#1
+    if (!signing) return words[i] == 0xd65f03c0U; // RET
+    return words[i] == (signing == 0xd503233fU ? 0xd65f0bffU : 0xd65f0fffU);
+}
