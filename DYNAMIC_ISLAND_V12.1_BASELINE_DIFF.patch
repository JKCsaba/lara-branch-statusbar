+static uint64_t rc_island121_object_member(RemoteCall *proc, uint64_t owner,
+                                          const char *name) {
+    if (!owner || proc.lastError.length) return 0;
+    uint64_t cls = RemoteArbCall(proc, object_getClass, owner);
+    if (!cls || proc.lastError.length) return 0;
+    uint64_t text = remote_alloc_str(proc, name);
+    if (!text || proc.lastError.length) return 0;
+    uint64_t ivar = RemoteArbCall(proc, class_getInstanceVariable, cls, text);
+    if (proc.lastError.length) return 0;
+    RemoteArbCall(proc, free, text);
+    if (!ivar || proc.lastError.length) return 0;
+    uint64_t encoding = RemoteArbCall(proc, ivar_getTypeEncoding, ivar);
+    char type = 0;
+    if (proc.lastError.length || !encoding ||
+        ![proc remoteRead:encoding to:&type size:1] || type != '@') return 0;
+    uint64_t result = RemoteArbCall(proc, object_getIvar, owner, ivar);
+    return proc.lastError.length ? 0 : result;
+}
