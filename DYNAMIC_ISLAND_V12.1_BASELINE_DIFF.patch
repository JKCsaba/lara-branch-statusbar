+// Fall back to runtime metadata for a directly held, explicitly typed controller.
+// This inspects declared object fields; it does not traverse views or call their
+// arbitrary accessors. Generic id/delegate fields are handled by the named links.
+static uint64_t rc_island121_typed_controller(RemoteCall *proc, uint64_t owner,
+                                              uint64_t wantedClass, uint64_t kind) {
+    if (!owner || proc.lastError.length) return 0;
+    uint64_t cls = RemoteArbCall(proc, object_getClass, owner);
+    if (!cls || proc.lastError.length) return 0;
+    uint64_t slot = RemoteArbCall(proc, malloc, sizeof(uint32_t));
+    if (!slot || proc.lastError.length) return 0;
+    uint32_t zero = 0;
+    if (![proc remote_write:slot from:&zero size:sizeof(zero)]) {
+        RemoteArbCall(proc, free, slot);
+        return 0;
+    }
+    uint64_t ivars = RemoteArbCall(proc, class_copyIvarList, cls, slot);
+    uint32_t count = 0;
+    bool read = !proc.lastError.length && [proc remoteRead:slot to:&count size:sizeof(count)];
+    if (!proc.lastError.length) RemoteArbCall(proc, free, slot);
+    if (proc.lastError.length) return 0;
+    uint64_t entries[64] = {0};
+    uint64_t found = 0;
+    if (read && ivars && count <= 64 && [proc remoteRead:ivars to:entries size:count * sizeof(uint64_t)]) {
+        for (uint32_t i = 0; i < count && !proc.lastError.length; i++) {
+            uint64_t encoding = RemoteArbCall(proc, ivar_getTypeEncoding, entries[i]);
+            char type[64] = {0};
+            if (!encoding || proc.lastError.length || ![proc remoteRead:encoding to:type size:63]) continue;
+            if (strcmp(type, "@\"SBSystemApertureController\"") != 0) continue;
+            uint64_t candidate = RemoteArbCall(proc, object_getIvar, owner, entries[i]);
+            if (rc_island120_send(proc, candidate, kind, wantedClass)) {
+                found = candidate;
+                break;
+            }
+        }
+    }
+    if (ivars && !proc.lastError.length) RemoteArbCall(proc, free, ivars);
+    return proc.lastError.length ? 0 : found;
+}
