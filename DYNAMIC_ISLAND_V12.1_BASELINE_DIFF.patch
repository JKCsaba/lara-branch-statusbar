+static bool rc_island121_signature(RemoteCall *proc, uint64_t method) {
+    if (!method || proc.lastError.length) return false;
+    uint64_t count = RemoteArbCall(proc, method_getNumberOfArguments, method);
+    if (proc.lastError.length || count != 5) return false;
+    uint64_t encoding = RemoteArbCall(proc, method_getTypeEncoding, method);
+    char resultType = 0;
+    if (proc.lastError.length || !encoding ||
+        ![proc remoteRead:encoding to:&resultType size:1] || resultType != 'v') return false;
+    for (unsigned index = 2; index <= 4; index++) {
+        uint64_t type = RemoteArbCall(proc, method_copyArgumentType, method, index);
+        char value = 0;
+        bool read = type && !proc.lastError.length && [proc remoteRead:type to:&value size:1];
+        if (type && !proc.lastError.length) RemoteArbCall(proc, free, type);
+        if (!read || proc.lastError.length || value != (index == 4 ? '@' : 'q')) return false;
+    }
+    return true;
+}
