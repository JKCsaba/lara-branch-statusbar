+static void rc_search_diag_print_string(RemoteCall *proc, uint64_t string,
+                                        const char *label) {
+    uint64_t bytes = string ? remote_msg(proc, string,
+        remote_sel(proc, "UTF8String"), 0, 0, 0, 0) : 0;
+    uint64_t length = string ? remote_msg(proc, string,
+        remote_sel(proc, "lengthOfBytesUsingEncoding:"), NSUTF8StringEncoding, 0, 0, 0) : 0;
+    // Bound diagnostic output. Never call unbounded remote strlen on view data.
+    size_t amount = (size_t)(length > 262144 ? 262144 : length);
+    char *buffer = bytes ? calloc(amount + 1, 1) : NULL;
+    if (buffer && [proc remoteRead:bytes to:buffer size:amount]) {
+        printf("(rc) v11.7 search diagnostic: %s\n%s\n", label, buffer);
+        if (length > amount) printf("(rc) v11.7 search diagnostic: text truncated at %zu bytes\n", amount);
+    } else printf("(rc) v11.7 search diagnostic: %s unavailable\n", label);
+    free(buffer);
+}
