+static void rc_search_diag_release(RemoteCall *proc, uint64_t object) {
+    if (object) remote_msg(proc, object, remote_sel(proc, "release"), 0, 0, 0, 0);
+}
+
+static int rc_search_diag_object(RemoteCall *proc, uint64_t target,
+                                 const char *name, uint64_t *out) {
+    *out = 0;
+    return rc_search_diag_read(proc, target, name, out, sizeof(*out), YES);
+}
