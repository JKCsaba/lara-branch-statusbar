+    if (remote_msg(proc, root, remote_sel(proc, "respondsToSelector:"),
+        remote_sel(proc, "recursiveDescription"), 0, 0, 0)) {
+        if (rc_search_diag_object(proc, root, "recursiveDescription", &tree)) goto cleanup;
+        rc_search_diag_print_string(proc, tree, "BEGIN Home view tree");
