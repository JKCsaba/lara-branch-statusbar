+        }
+        rc_search_diag_release(proc, root);
+        root = parent;
+    }
+    if (!reachedWindow) {
+        printf("(rc) v11.7 search diagnostic: no complete Home hierarchy above Dock; stopped\n");
+        goto cleanup;
+    }
+    if (rc_search_diag_view(proc, root, "Home hierarchy root")) goto cleanup;
