+            uint64_t child = remote_msg(proc, children, remote_sel(proc, "objectAtIndex:"), i, 0, 0, 0);
+            if (child) pending[pendingCount++] = remote_msg(proc, child, remote_sel(proc, "retain"), 0, 0, 0, 0);
+        }
+        rc_search_diag_release(proc, children);
+        rc_search_diag_release(proc, view);
+    }
+    if (pendingCount) truncated = YES;
+    printf("(rc) v11.7 search diagnostic: visited=%zu matches=%zu truncated=%d\n", visited, matchCount, truncated);
+    for (size_t m = 0; m < matchCount; m++) {
+        uint64_t current = remote_msg(proc, matches[m], remote_sel(proc, "retain"), 0, 0, 0, 0);
+        for (int depth = 0; current && depth < 16; depth++) {
