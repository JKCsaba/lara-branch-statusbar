+static int rc_search_diag_view(RemoteCall *proc, uint64_t view, const char *label) {
+    CGRect frame = CGRectZero, bounds = CGRectZero;
+    uint64_t interaction = 0, hidden = 0, clips = 0, description = 0;
+    if (rc_search_diag_read(proc, view, "frame", &frame, sizeof(frame), NO) ||
+        rc_search_diag_read(proc, view, "bounds", &bounds, sizeof(bounds), NO) ||
+        rc_search_diag_read(proc, view, "isUserInteractionEnabled", &interaction, sizeof(interaction), NO) ||
+        rc_search_diag_read(proc, view, "isHidden", &hidden, sizeof(hidden), NO) ||
+        rc_search_diag_read(proc, view, "clipsToBounds", &clips, sizeof(clips), NO) ||
+        rc_search_diag_object(proc, view, "description", &description)) return -1;
+    printf("(rc) v11.7 search diagnostic: %s ptr=0x%llx frame={%.2f,%.2f,%.2f,%.2f} bounds={%.2f,%.2f,%.2f,%.2f} interaction=%llu hidden=%llu clips=%llu\n",
+        label, (unsigned long long)view,
+        frame.origin.x, frame.origin.y, frame.size.width, frame.size.height,
+        bounds.origin.x, bounds.origin.y, bounds.size.width, bounds.size.height,
+        (unsigned long long)interaction, (unsigned long long)hidden, (unsigned long long)clips);
+    rc_search_diag_print_string(proc, description, "runtime view description (class/layer/transform)");
+    rc_search_diag_release(proc, description);
+    uint64_t gestures = 0;
+    if (rc_search_diag_object(proc, view, "gestureRecognizers", &gestures)) return -1;
+    if (gestures) {
+        uint64_t text = remote_msg(proc, gestures, remote_sel(proc, "description"), 0, 0, 0, 0);
+        rc_search_diag_print_string(proc, text, "gesture recognizers");
+        rc_search_diag_release(proc, gestures);
+    }
+    return 0;
+}
