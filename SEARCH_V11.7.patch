+    while (pendingCount) rc_search_diag_release(proc, pending[--pendingCount]);
+    for (size_t m = 0; m < matchCount; m++) rc_search_diag_release(proc, matches[m]);
+    rc_search_diag_release(proc, root);
+    printf("(rc) v11.7 search diagnostic: END result=%d; no UI geometry changed\n", result);
+    fflush(stdout);
+    return result;
+}
