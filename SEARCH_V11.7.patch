+static int rc_search_diag_read(RemoteCall *proc, uint64_t target,
+                               const char *name, void *out, size_t size,
+                               BOOL objectResult) {
+    uint64_t selector = remote_sel(proc, name);
+    if (!target || !selector || !remote_msg(proc, target,
+        remote_sel(proc, "respondsToSelector:"), selector, 0, 0, 0)) return -1;
+    uint64_t signature = remote_msg(proc, target,
+        remote_sel(proc, "methodSignatureForSelector:"), selector, 0, 0, 0);
+    if (!signature) return -2;
+    uint64_t length = remote_msg(proc, signature,
+        remote_sel(proc, "methodReturnLength"), 0, 0, 0, 0);
+    uint64_t type = remote_msg(proc, signature,
+        remote_sel(proc, "methodReturnType"), 0, 0, 0, 0);
+    char encoding = 0;
+    if (!type || ![proc remoteRead:type to:&encoding size:1] ||
+        !length || length > size || (objectResult && encoding != '@')) return -3;
+    uint64_t invocationClass = remote_getClass(proc, "NSInvocation");
+    uint64_t operationClass = remote_getClass(proc, "NSInvocationOperation");
+    uint64_t invocation = invocationClass ? remote_msg(proc, invocationClass,
+        remote_sel(proc, "invocationWithMethodSignature:"), signature, 0, 0, 0) : 0;
+    if (!invocation || !operationClass) return -4;
+    remote_msg(proc, invocation, remote_sel(proc, "setTarget:"), target, 0, 0, 0);
+    remote_msg(proc, invocation, remote_sel(proc, "setSelector:"), selector, 0, 0, 0);
+    remote_msg(proc, invocation, remote_sel(proc, "retainArguments"), 0, 0, 0, 0);
+    uint64_t operation = RemoteArbCall(proc, objc_alloc, operationClass);
+    operation = operation ? remote_msg(proc, operation,
+        remote_sel(proc, "initWithInvocation:"), invocation, 0, 0, 0) : 0;
+    if (!operation) return -5;
+    remote_msg(proc, operation,
+        remote_sel(proc, "performSelectorOnMainThread:withObject:waitUntilDone:"),
+        remote_sel(proc, "start"), 0, 0, 0);
+    BOOL finished = NO;
+    for (int elapsed = 0; elapsed < 1500; elapsed += 20) {
+        finished = remote_msg(proc, operation, remote_sel(proc, "isFinished"), 0, 0, 0, 0) != 0;
+        if (finished) break;
+        usleep(20000);
+    }
+    if (!finished) {
+        // It may still execute. Leave its owning reference alive and stop the
+        // diagnostic; never reuse scratch memory for a queued invocation.
+        printf("(rc) v11.7 search diagnostic: main-thread getter %s timed out; stopped\n", name);
+        return -6;
